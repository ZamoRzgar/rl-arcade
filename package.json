{
  "name": "rl-arcade",
  "private": true,
  "version": "0.1.0",
  "description": "An interactive reinforcement learning sandbox with an arcade look. Change a knob, see what changes.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
